# كل متغيرات البيئة التي يقرؤها التطبيق. القيم هنا أمثلة وهمية؛ القيم الحقيقية تأتي من المنصة.

# --- التشغيل ---
# منفذ الاستماع (يرتبط التطبيق بكل الواجهات 0.0.0.0)
PORT=8080
# بيئة التشغيل: production تغلق كل تفاصيل الأخطاء الداخلية في الردود
NODE_ENV=production
# تفعيل تفاصيل الأخطاء في السجلات (يُتجاهل عندما NODE_ENV=production)
APP_DEBUG=false
# الرابط العام للموقع (يُستعمل في الروابط ورموز QR، وبدون شرطة أخيرة)
APP_URL=https://saif.example.com
# مهلة الإيقاف التدريجي بالثواني بعد SIGTERM
SHUTDOWN_GRACE_SECONDS=25

# --- لوحة الإدارة ---
# رمز دخول الإدارة (6 خانات على الأقل). بدونه تبقى اللوحة مقفلة. لا يُرسل بالبريد.
ADMIN_PIN=change-me-please

# --- الحماية من التضخم ---
# أقصى عدد جولات تُقبل في اليوم الواحد (بتوقيت الرياض). بعده تُرفض «add» بنتيجة full حتى اليوم التالي
MAX_ROUNDS_PER_DAY=2000

# --- قاعدة البيانات (PostgreSQL فقط) ---
# إما رابط كامل
DATABASE_URL=postgres://saif:password@db:5432/saif
# أو المتغيرات المنفصلة (تُستعمل عندما DATABASE_URL فارغ)
DB_HOST=db
DB_PORT=5432
DB_NAME=saif
DB_USER=saif
DB_PASSWORD=password
# وضع TLS: disable | prefer | require | verify-full
DB_SSLMODE=prefer
# أقصى عدد اتصالات لكل نسخة. اجعل (عدد النسخ × هذه القيمة) أقل من حد قاعدة البيانات
DB_POOL_MAX=10
# رابط منفصل للهجرات يتجاوز PgBouncer (اتصال جلسة). افتراضيًا يستعمل إعدادات القاعدة أعلاه
MIGRATION_DATABASE_URL=
# تشغيل الهجرات عند الإقلاع. الأفضل false وتشغيل أمر الهجرة المستقل قبل النسخة الجديدة
RUN_MIGRATIONS=false

# --- التخزين المتوافق مع S3 (للموشن الكبير فقط) ---
# عنوان النقطة النهائية (قابل للتجاوز: ليس بالضرورة AWS)
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=saif-assets
S3_ACCESS_KEY_ID=example-access-key
S3_SECRET_ACCESS_KEY=example-secret-key
S3_FORCE_PATH_STYLE=true
# الرابط العام لقراءة الملفات (CDN أو الحاوية). التطبيق يحوّل /video/*.mp4 إليه
S3_PUBLIC_URL=https://cdn.example.com/saif-assets
